<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Rule 1: Di bawah Rp5.000.000 -> Supervisor -->
        <record id="approval_rule_supervisor" model="purchase.approval.rule">
            <field name="name">Under 5M IDR - Supervisor Approval</field>
            <field name="sequence">10</field>
            <field name="level">supervisor</field>
            <field name="min_amount">0.0</field>
            <field name="max_amount">4999999.0</field>
            <field name="group_id" ref="group_pr_supervisor"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Rule 2: Rp5.000.000 sampai Rp50.000.000 -> Manager -->
        <record id="approval_rule_manager" model="purchase.approval.rule">
            <field name="name">5M to 50M IDR - Manager Approval</field>
            <field name="sequence">20</field>
            <field name="level">manager</field>
            <field name="min_amount">5000000.0</field>
            <field name="max_amount">50000000.0</field>
            <field name="group_id" ref="group_pr_manager"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Rule 3: Di atas Rp50.000.000 -> Director (Tanpa batas atas) -->
        <record id="approval_rule_director" model="purchase.approval.rule">
            <field name="name">Above 50M IDR - Director Approval</field>
            <field name="sequence">30</field>
            <field name="level">director</field>
            <field name="min_amount">50000001.0</field>
            <field name="max_amount">0.0</field>
            <field name="group_id" ref="group_pr_director"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>

