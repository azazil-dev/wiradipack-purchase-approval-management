<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron: Daily Approval Reminder -->
        <record id="ir_cron_purchase_request_reminder" model="ir.cron">
            <field name="name">Purchase Request: Approval SLA Reminder</field>
            <field name="model_id" ref="model_purchase_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_approval_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron: Daily Approval Escalation -->
        <record id="ir_cron_purchase_request_escalation" model="ir.cron">
            <field name="name">Purchase Request: Approval SLA Escalation</field>
            <field name="model_id" ref="model_purchase_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_approval_escalation()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron: Weekly Stale Draft Reminder -->
        <record id="ir_cron_purchase_request_stale_draft" model="ir.cron">
            <field name="name">Purchase Request: Stale Draft Reminder</field>
            <field name="model_id" ref="model_purchase_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_stale_draft_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
