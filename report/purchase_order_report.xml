                }
            </style>

            <!-- Header -->
            <table class="header-table">
                <tr>
                    <td style="width: 55%;">
                        <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 48px; margin-bottom: 8px;" alt="Logo"/>
                        <div class="company-title" t-field="o.company_id.name"/>
                        <div class="company-text">
                            <span t-if="o.company_id.street" t-field="o.company_id.street"/>
                            <span t-if="o.company_id.city">, <span t-field="o.company_id.city"/></span><br/>
                            <span t-if="o.company_id.phone">Phone: <span t-field="o.company_id.phone"/> | </span>
                            <span t-if="o.company_id.email" t-field="o.company_id.email"/>
                        </div>
                    </td>
                    <td style="width: 45%;">
                        <div class="doc-title">REQUEST FOR QUOTATION</div>
                        <div class="doc-meta">
                            RFQ Ref: <strong style="color: #111;" t-field="o.name"/><br/>
                            <t t-if="o.purchase_request_id">
                                PR Reference: <strong style="color: #111;" t-field="o.purchase_request_id.name"/><br/>
                            </t>
                            Date: <strong style="color: #111;"><span t-field="o.date_order" t-options='{"widget": "date"}'/></strong>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- Info: Vendor & Inquiry Details -->
            <table class="info-table">
                <tr>
                    <td style="width: 50%; padding-right: 25px;">
                        <div class="info-caption">TO VENDOR / SUPPLIER</div>
                        <div style="font-size: 13px; font-weight: 700; color: #111; margin-bottom: 3px;" t-field="o.partner_id.name"/>
                        <div style="color: #4B5563; line-height: 1.4;">
                            <span t-if="o.partner_id.street" t-field="o.partner_id.street"/><br t-if="o.partner_id.street"/>
                            <span t-if="o.partner_id.city" t-field="o.partner_id.city"/>
                            <span t-if="o.partner_id.country_id">, <span t-field="o.partner_id.country_id.name"/></span><br t-if="o.partner_id.city"/>
                            <span t-if="o.partner_id.phone">Phone: <span t-field="o.partner_id.phone"/><br/></span>
                            <span t-if="o.partner_id.email">Email: <span t-field="o.partner_id.email"/></span>
                        </div>
                    </td>
                    <td style="width: 50%;">
                        <div class="info-caption">INQUIRY SPECIFICATIONS</div>
                        <table class="meta-sub-table">
                            <tr t-if="o.user_id">
                                <td class="meta-label">Contact Person</td>
                                <td class="meta-sep">:</td>
                                <td class="meta-val"><span t-field="o.user_id.name"/></td>
                            </tr>
                            <tr>
                                <td class="meta-label">Destination</td>
                                <td class="meta-sep">:</td>
                                <td class="meta-val">
                                    <span t-if="o.dest_address_id" t-field="o.dest_address_id.name"/>
                                    <span t-elif="o.picking_type_id and o.picking_type_id.warehouse_id" t-field="o.picking_type_id.warehouse_id.name"/>
