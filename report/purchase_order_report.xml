                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <div style="color: #6B7280; font-size: 10.5px; margin-bottom: 8px;">
                Please provide your best quotation, price, lead time, and payment terms for the requested items below:
            </div>

            <!-- Items Table -->
            <table class="items-table">
                <thead>
                    <tr>
                        <th style="width: 5%; text-align: center;">#</th>
                        <th style="width: 53%; text-align: left;">Item &amp; Description</th>
                        <th style="width: 20%; text-align: center;">Expected Date</th>
                        <th style="width: 22%; text-align: right;">Quantity Required</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="idx" t-value="0"/>
                    <t t-foreach="o.order_line" t-as="order_line">
                        <t t-if="not order_line.display_type">
                            <t t-set="idx" t-value="idx + 1"/>
                            <tr>
                                <td style="text-align: center; color: #9CA3AF;"><t t-esc="idx"/></td>
                                <td>
                                    <strong style="color: #111;" t-field="order_line.product_id.name"/>
                                    <div t-if="order_line.name and order_line.name != order_line.product_id.name" style="font-size: 10px; color: #6B7280;">
                                        <span t-field="order_line.name"/>
                                    </div>
                                </td>
                                <td style="text-align: center; color: #4B5563;">
                                    <span t-field="order_line.date_planned" t-options='{"widget": "date"}'/>
                                </td>
                                <td style="text-align: right;">
                                    <strong t-field="order_line.product_qty"/>
                                    <span style="font-size: 9.5px; color: #6B7280;" t-field="order_line.product_uom.name"/>
                                </td>
                            </tr>
                        </t>
                        <t t-elif="order_line.display_type == 'line_section'">
                            <tr style="background-color: #F9FAFB;">
                                <td colspan="4" style="font-weight: 700; padding: 6px 4px;"><span t-field="order_line.name"/></td>
                            </tr>
                        </t>
                        <t t-elif="order_line.display_type == 'line_note'">
                            <tr>
                                <td colspan="4" style="font-style: italic; color: #6B7280; font-size: 10px; padding: 4px;"><span t-field="order_line.name"/></td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            <div t-if="o.notes" style="margin-top: 15px;">
                <div class="info-caption">SPECIAL INSTRUCTIONS / NOTES</div>
                <div style="font-size: 10.5px; color: #6B7280; line-height: 1.4;" t-field="o.notes"/>
            </div>

            <!-- Signatures -->
            <table class="sign-table" style="page-break-inside: avoid;">
                <tr>
                    <td style="width: 45%;">
                        <div class="sign-line">Purchasing Dept.</div>
                    </td>
                    <td style="width: 10%;"></td>
                    <td style="width: 45%;">
                        <div class="sign-line">Vendor Acceptance &amp; Stamp</div>
                    </td>
                </tr>
            </table>

            <!-- Footer -->
            <table class="footer-table">
                <tr>
                    <td style="width: 70%;">PT Wiradi Utama Packindo Procurement &amp; Purchasing System</td>
                    <td style="width: 30%; text-align: right;">Ref: <span t-field="o.name"/></td>
                </tr>
            </table>

        </div>
    </template>
</odoo>
