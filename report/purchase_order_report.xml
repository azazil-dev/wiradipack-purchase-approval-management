<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dedicated Paperformat for Clean Minimalist Purchase Reports -->
    <record id="paperformat_clean_purchase" model="report.paperformat">
        <field name="name">Clean Purchase Document A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Point purchase report actions to clean custom document templates with dedicated paperformat -->
    <record id="purchase.action_report_purchase_order" model="ir.actions.report">
        <field name="report_name">purchase_approval_management.report_purchaseorder_custom</field>
        <field name="report_file">purchase_approval_management.report_purchaseorder_custom</field>
        <field name="paperformat_id" ref="paperformat_clean_purchase"/>
    </record>

    <record id="purchase.report_purchase_quotation" model="ir.actions.report">
        <field name="report_name">purchase_approval_management.report_purchasequotation_custom</field>
        <field name="report_file">purchase_approval_management.report_purchasequotation_custom</field>
        <field name="paperformat_id" ref="paperformat_clean_purchase"/>
    </record>

    <!-- Wrappers -->
    <template id="report_purchaseorder_custom">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="purchase_approval_management.report_purchaseorder_document_custom" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <template id="report_purchasequotation_custom">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="purchase_approval_management.report_purchasequotation_document_custom" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <!-- Custom Document: Purchase Order (Refined, Modern, Flat & Perfectly Aligned) -->
    <template id="report_purchaseorder_document_custom">
        <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
        <div class="article" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 11px; color: #1F2937; line-height: 1.45; width: 100%;">
            <style>
                table {
                    width: 100% !important;
                    border-collapse: collapse;
                    table-layout: fixed;
                }
                .header-table td {
                    vertical-align: top;
                    padding-bottom: 14px;
                    border-bottom: 2px solid #111827;
                }
                .doc-title {
                    font-size: 22px;
                    font-weight: 800;
                    color: #111827;
                    letter-spacing: -0.2px;
                    text-align: right;
                    margin: 0;
                    line-height: 1.1;
                }
                .doc-meta {
                    text-align: right;
                    font-size: 11.5px;
                    color: #4B5563;
                    margin-top: 5px;
                    line-height: 1.5;
                }
                .company-title {
                    font-size: 14px;
                    font-weight: 700;
                    color: #111827;
                    margin-bottom: 2px;
                }
                .company-text {
                    font-size: 10.5px;
                    color: #6B7280;
                    line-height: 1.35;
                }
                .info-table {
                    margin-top: 14px;
                    margin-bottom: 14px;
                }
                .info-table td {
                    vertical-align: top;
                }
                .info-caption {
                    font-size: 10px;
                    font-weight: 700;
                    color: #9CA3AF;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                    margin-bottom: 4px;
                }
                .meta-sub-table td {
                    padding: 2px 0;
                    font-size: 11px;
                }
                .meta-label {
                    width: 115px;
                    color: #6B7280;
                }
                .meta-sep {
                    width: 15px;
                    color: #9CA3AF;
                    text-align: center;
                }
                .meta-val {
                    color: #111827;
                    font-weight: 600;
                }
                .items-table {
                    margin-top: 15px;
                    margin-bottom: 15px;
                }
                .items-table th {
                    border-top: 1px solid #111827;
                    border-bottom: 1px solid #111827;
                    padding: 7px 4px;
                    font-size: 10px;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 0.3px;
                    color: #111827;
                }
                .items-table td {
                    padding: 8px 4px;
                    border-bottom: 1px solid #E5E7EB;
                    font-size: 11px;
                    vertical-align: top;
                }
                .items-table th:first-child, .items-table td:first-child { padding-left: 0 !important; }
                .items-table th:last-child, .items-table td:last-child { padding-right: 0 !important; }
                .items-table tr:last-child td { border-bottom: 1.5px solid #111827; }
                .summary-table td {
                    padding: 3px 0;
                    font-size: 11px;
                }
                .sum-label { color: #6B7280; }
                .sum-val { text-align: right; font-weight: 600; color: #111827; padding-right: 0 !important; }
                .total-row td {
                    border-top: 1.5px solid #111827;
                    font-size: 13px;
                    font-weight: 800;
                    padding-top: 6px;
                    color: #111827;
                }
                .sign-table {
                    margin-top: 45px;
                }
                .sign-line {
                    border-top: 1px solid #9CA3AF;
                    padding-top: 5px;
                    text-align: center;
                    font-size: 10.5px;
                    font-weight: 600;
                    color: #4B5563;
                }
                .footer-table {
                    margin-top: 35px;
                    border-top: 1px solid #E5E7EB;
                    padding-top: 6px;
                    font-size: 9px;
                    color: #9CA3AF;
                }
            </style>

            <!-- Header -->
            <table class="header-table">
                <tr>
                    <td style="width: 55%;">
                        <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 48px; margin-bottom: 8px;" alt="Logo"/>
                        <div class="company-title" t-field="o.company_id.name"/>
                        <div class="company-text">
                            <span t-if="o.company_id.street" t-field="o.company_id.street"/>
                            <span t-if="o.company_id.city">, <span t-field="o.company_id.city"/></span><br/>
                            <span t-if="o.company_id.phone">Phone: <span t-field="o.company_id.phone"/> | </span>
                            <span t-if="o.company_id.email" t-field="o.company_id.email"/>
                        </div>
                    </td>
                    <td style="width: 45%;">
                        <div class="doc-title">
                            <span t-if="o.state in ['draft', 'sent', 'to approve']">REQUEST FOR QUOTATION</span>
                            <span t-if="o.state in ['purchase', 'done']">PURCHASE ORDER</span>
                            <span t-if="o.state == 'cancel'">CANCELLED ORDER</span>
                        </div>
                        <div class="doc-meta">
                            Order No: <strong style="color: #111;" t-field="o.name"/><br/>
                            <t t-if="o.purchase_request_id">
                                PR Reference: <strong style="color: #111;" t-field="o.purchase_request_id.name"/><br/>
                            </t>
                            Order Date: <strong style="color: #111;">
                                <span t-if="o.date_approve" t-field="o.date_approve" t-options='{"widget": "date"}'/>
                                <span t-elif="o.date_order" t-field="o.date_order" t-options='{"widget": "date"}'/>
                            </strong>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- Info: Vendor & Order -->
            <table class="info-table">
                <tr>
                    <td style="width: 50%; padding-right: 25px;">
                        <div class="info-caption">VENDOR / SUPPLIER</div>
                        <div style="font-size: 13px; font-weight: 700; color: #111; margin-bottom: 3px;" t-field="o.partner_id.name"/>
                        <div style="color: #4B5563; line-height: 1.4;">
                            <span t-if="o.partner_id.street" t-field="o.partner_id.street"/><br t-if="o.partner_id.street"/>
                            <span t-if="o.partner_id.city" t-field="o.partner_id.city"/>
                            <span t-if="o.partner_id.country_id">, <span t-field="o.partner_id.country_id.name"/></span><br t-if="o.partner_id.city"/>
                            <span t-if="o.partner_id.phone">Phone: <span t-field="o.partner_id.phone"/><br/></span>
                            <span t-if="o.partner_id.email">Email: <span t-field="o.partner_id.email"/><br/></span>
                            <span t-if="o.partner_id.vat">NPWP / Tax ID: <span t-field="o.partner_id.vat"/></span>
                        </div>
                    </td>
                    <td style="width: 50%;">
                        <div class="info-caption">ORDER DETAILS</div>
                        <table class="meta-sub-table">
                            <tr t-if="o.user_id">
                                <td class="meta-label">Purchasing Rep</td>
                                <td class="meta-sep">:</td>
                                <td class="meta-val"><span t-field="o.user_id.name"/></td>
                            </tr>
                            <tr t-if="o.partner_ref">
                                <td class="meta-label">Vendor Reference</td>
                                <td class="meta-sep">:</td>
                                <td class="meta-val"><span t-field="o.partner_ref"/></td>
                            </tr>
                            <tr t-if="o.payment_term_id">
                                <td class="meta-label">Payment Terms</td>
                                <td class="meta-sep">:</td>
                                <td class="meta-val"><span t-field="o.payment_term_id.name"/></td>
                            </tr>
                            <tr>
                                <td class="meta-label">Destination</td>
                                <td class="meta-sep">:</td>
                                <td class="meta-val">
                                    <span t-if="o.dest_address_id" t-field="o.dest_address_id.name"/>
                                    <span t-elif="o.picking_type_id and o.picking_type_id.warehouse_id" t-field="o.picking_type_id.warehouse_id.name"/>
                                    <span t-else="" t-field="o.company_id.name"/>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <!-- Items Table -->
            <table class="items-table">
                <thead>
                    <tr>
                        <th style="width: 5%; text-align: center;">#</th>
                        <th style="width: 45%; text-align: left;">Item &amp; Description</th>
                        <th style="width: 14%; text-align: center;">Expected Date</th>
                        <th style="width: 10%; text-align: right;">Qty</th>
                        <th style="width: 13%; text-align: right;">Unit Price</th>
                        <th style="width: 13%; text-align: right;">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="idx" t-value="0"/>
                    <t t-foreach="o.order_line" t-as="line">
                        <t t-if="not line.display_type">
                            <t t-set="idx" t-value="idx + 1"/>
                            <tr>
                                <td style="text-align: center; color: #9CA3AF;"><t t-esc="idx"/></td>
                                <td>
                                    <strong style="color: #111;" t-field="line.product_id.name"/>
                                    <div t-if="line.name and line.name != line.product_id.name" style="font-size: 10px; color: #6B7280;">
                                        <span t-field="line.name"/>
                                    </div>
                                </td>
                                <td style="text-align: center; color: #4B5563;">
                                    <span t-field="line.date_planned" t-options='{"widget": "date"}'/>
                                </td>
                                <td style="text-align: right;">
                                    <strong t-field="line.product_qty"/>
                                    <span style="font-size: 9.5px; color: #6B7280;" t-field="line.product_uom.name"/>
                                </td>
                                <td style="text-align: right;">
                                    <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td style="text-align: right; font-weight: 700;">
                                    <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                        <t t-elif="line.display_type == 'line_section'">
                            <tr style="background-color: #F9FAFB;">
                                <td colspan="6" style="font-weight: 700; padding: 6px 4px;"><span t-field="line.name"/></td>
                            </tr>
                        </t>
                        <t t-elif="line.display_type == 'line_note'">
                            <tr>
                                <td colspan="6" style="font-style: italic; color: #6B7280; font-size: 10px; padding: 4px;"><span t-field="line.name"/></td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            <!-- Summary & Notes -->
            <table>
                <tr>
                    <td style="width: 58%; vertical-align: top; padding-right: 30px;">
                        <div t-if="o.notes">
                            <div class="info-caption">SPECIAL NOTES / TERMS</div>
                            <div style="font-size: 10.5px; color: #6B7280; line-height: 1.4;" t-field="o.notes"/>
                        </div>
                    </td>
                    <td style="width: 42%; vertical-align: top;">
                        <table class="summary-table">
                            <tr>
                                <td class="sum-label">Subtotal (Untaxed)</td>
                                <td class="sum-val">
                                    <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                            <tr t-if="o.amount_tax">
                                <td class="sum-label">PPN / Tax</td>
                                <td class="sum-val">
                                    <span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                            <tr class="total-row">
                                <td>TOTAL AMOUNT</td>
                                <td class="sum-val" style="font-size: 13px; font-weight: 800;">
                                    <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <!-- Signatures -->
            <table class="sign-table" style="page-break-inside: avoid;">
                <tr>
                    <td style="width: 30%;">
                        <div class="sign-line">Purchasing Dept.</div>
                    </td>
                    <td style="width: 5%;"></td>
                    <td style="width: 30%;">
                        <div class="sign-line">Authorized Management</div>
                    </td>
                    <td style="width: 5%;"></td>
                    <td style="width: 30%;">
                        <div class="sign-line">Vendor Acceptance</div>
                    </td>
                </tr>
            </table>

            <!-- Footer -->
            <table class="footer-table">
                <tr>
                    <td style="width: 70%;">PT Wiradi Utama Packindo Procurement &amp; Purchasing System</td>
                    <td style="width: 30%; text-align: right;">Document Ref: <span t-field="o.name"/></td>
                </tr>
            </table>

        </div>
    </template>

    <!-- Custom Document: RFQ (Refined, Modern, Flat & Perfectly Aligned) -->
    <template id="report_purchasequotation_document_custom">
        <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
        <div class="article" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 11px; color: #1F2937; line-height: 1.45; width: 100%;">
