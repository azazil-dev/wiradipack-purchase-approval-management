<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- QWeb PDF Report Action -->
    <record id="action_report_purchase_request" model="ir.actions.report">
        <field name="name">Purchase Request</field>
        <field name="model">purchase.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">purchase_approval_management.report_purchaserequest_document</field>
        <field name="report_file">purchase_approval_management.report_purchaserequest_document</field>
        <field name="print_report_name">'Purchase_Request_' + object.name.replace('/', '_')</field>
        <field name="binding_model_id" ref="model_purchase_request"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb Template -->
    <template id="report_purchaserequest_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>

                        <h2 class="mt-4">
                            <span>Purchase Request: </span>
                            <span t-field="doc.name"/>
                        </h2>

                        <div class="row mt-4 mb-4">
                            <div class="col-6">
                                <strong>Requester:</strong> <span t-field="doc.requester_id.name"/><br/>
                                <strong>Department:</strong> <span t-field="doc.department_id.name"/><br/>
                                <strong>Company:</strong> <span t-field="doc.company_id.name"/>
                            </div>
                            <div class="col-6">
                                <strong>Request Date:</strong> <span t-field="doc.date_request"/><br/>
                                <strong>Date Required:</strong> <span t-field="doc.date_required"/><br/>
                                <strong>Status:</strong> <span t-field="doc.state"/><br/>
                                <strong>Required Level:</strong> <span t-field="doc.required_level"/>
                            </div>
                        </div>

                        <div class="mb-4">
                            <strong>Reason / Purpose:</strong>
                            <p t-field="doc.reason"/>
                        </div>

                        <h4>Requested Items</h4>
                        <table class="table table-sm o_main_table table-striped mt-2">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Description</th>
                                    <th class="text-end">Quantity</th>
                                    <th>UoM</th>
                                    <th class="text-end">Est. Unit Price</th>
                                    <th class="text-end">Subtotal</th>
                                    <th>Suggested Vendor</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.line_ids" t-as="line">
                                    <td><span t-field="line.product_id.display_name"/></td>
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end"><span t-field="line.product_qty"/></td>
                                    <td><span t-field="line.product_uom_id.name"/></td>
                                    <td class="text-end"><span t-field="line.estimated_unit_price" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                    <td class="text-end"><span t-field="line.subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                    <td><span t-field="line.suggested_vendor_id.name"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="clearfix">
                            <div class="row">
                                <div class="col-4 ms-auto">
                                    <table class="table table-sm">
                                        <tr class="border-black">
                                            <td><strong>Total</strong></td>
                                            <td class="text-end">
                                                <span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <h4 class="mt-4">Approval Trail</h4>
                        <table class="table table-sm table-bordered mt-2">
                            <thead>
                                <tr>
                                    <th>Round</th>
                                    <th>Sequence</th>
                                    <th>Level</th>
                                    <th>Status</th>
                                    <th>Approver</th>
                                    <th>Action Date</th>
                                    <th>Comment</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.approval_line_ids" t-as="app_line">
                                    <td><span t-field="app_line.round_no"/></td>
                                    <td><span t-field="app_line.sequence"/></td>
                                    <td><span t-field="app_line.level"/></td>
                                    <td><span t-field="app_line.state"/></td>
                                    <td><span t-field="app_line.approver_id.name"/></td>
                                    <td><span t-field="app_line.action_date"/></td>
                                    <td><span t-field="app_line.comment"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

