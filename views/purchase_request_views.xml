<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_purchase_request_tree" model="ir.ui.view">
        <field name="name">purchase.request.tree</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <tree string="Purchase Requests" decoration-danger="is_overdue" decoration-muted="state == 'cancel'" decoration-info="state == 'draft'" decoration-warning="state == 'to_approve'" decoration-success="state in ('approved', 'done')">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="department_id"/>
                <field name="date_request"/>
                <field name="date_required"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="required_level" widget="badge"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'to_approve'" decoration-success="state in ('approved', 'done')" decoration-danger="state == 'rejected'"/>
                <field name="is_overdue" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <form string="Purchase Request">
                <header>
                    <button name="action_submit" string="Submit for Approval" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-success" invisible="state != 'to_approve' or not can_approve"/>
                    <button name="%(action_purchase_request_reject_wizard)d" string="Reject" type="action" class="btn-danger" invisible="state != 'to_approve' or not can_approve"/>
                    <button name="action_revise" string="Revise Request" type="object" class="btn-secondary" invisible="state != 'rejected'"/>
                    <button name="%(action_purchase_request_make_po_wizard)d" string="Create PO" type="action" class="btn-primary" groups="purchase_approval_management.group_pr_purchasing,purchase_approval_management.group_pr_admin" invisible="state != 'approved'"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" invisible="state not in ('draft', 'to_approve')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,to_approve,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="action" name="%(purchase.purchase_rfq)d" icon="fa-shopping-cart" invisible="po_count == 0" context="{'search_default_purchase_request_id': id}">
                            <field string="Purchase Orders" name="po_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <span class="o_form_label">Purchase Request</span>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="requester_id" readonly="state != 'draft'"/>
                            <field name="department_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date_request" readonly="state != 'draft'"/>
                            <field name="date_required" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="state != 'draft'"/>
                            <field name="required_level" widget="badge"/>
                            <field name="can_approve" invisible="1"/>
                            <field name="round_no" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason" placeholder="Explain the business purpose and need for this purchase..." readonly="state != 'draft'"/>
                        <field name="reject_reason" invisible="not reject_reason" readonly="1" class="text-danger fw-bold"/>
                    </group>

                    <notebook>
                        <page string="Items" name="request_lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <tree editable="bottom">
                                    <field name="company_id" column_invisible="True"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_category_id" column_invisible="True"/>
                                    <field name="product_uom_id"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="estimated_unit_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="subtotal" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="suggested_vendor_id"/>
                                    <field name="date_required"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="amount_total_company" widget="monetary" options="{'currency_field': 'company_currency_id'}" groups="base.group_multi_currency"/>
                                <field name="company_currency_id" invisible="1"/>
                            </group>
                        </page>

                        <page string="Approval Steps" name="approval_steps">
                            <field name="approval_line_ids" readonly="1">
                                <tree>
                                    <field name="round_no"/>
                                    <field name="sequence"/>
                                    <field name="level" widget="badge"/>
                                    <field name="group_id"/>
                                    <field name="state" widget="badge" decoration-warning="state == 'pending'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-muted="state in ('waiting', 'skipped')"/>
                                    <field name="approver_id"/>
                                    <field name="action_date"/>
                                    <field name="comment"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Approval History" name="approval_history">
                            <field name="history_ids" readonly="1">
                                <tree>
                                    <field name="round_no"/>
                                    <field name="action_date"/>
                                    <field name="actor_id"/>
                                    <field name="level" widget="badge"/>
                                    <field name="action" widget="badge"/>
                                    <field name="state_from"/>
                                    <field name="state_to"/>
                                    <field name="amount_snapshot" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="comment"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_purchase_request_kanban" model="ir.ui.view">
        <field name="name">purchase.request.kanban</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="requester_id"/>
                <field name="department_id"/>
                <field name="amount_total"/>
                <field name="currency_id"/>
                <field name="required_level"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click p-2">
                            <div class="o_kanban_record_top mb-1">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <span class="badge text-bg-secondary"><field name="required_level"/></span>
                            </div>
                            <div class="text-muted small">
                                <div><field name="requester_id"/> - <field name="department_id"/></div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_purchase_request_search" model="ir.ui.view">
        <field name="name">purchase.request.search</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <search string="Search Purchase Requests">
                <field name="name" string="Reference"/>
                <field name="requester_id"/>
                <field name="department_id"/>
                <separator/>
                <filter string="My Requests" name="my_requests" domain="[('requester_id', '=', uid)]"/>
                <filter string="Waiting My Approval" name="waiting_my_approval" domain="[('state', '=', 'to_approve'), ('pending_approver_ids', 'in', [uid])]"/>
                <filter string="Overdue" name="overdue" domain="[('is_overdue', '=', True)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="To Approve" name="to_approve" domain="[('state', '=', 'to_approve')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Department" name="group_by_department" domain="[]" context="{'group_by': 'department_id'}"/>
                    <filter string="Requester" name="group_by_requester" domain="[]" context="{'group_by': 'requester_id'}"/>
                    <filter string="Required Level" name="group_by_level" domain="[]" context="{'group_by': 'required_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Act Windows -->
    <record id="action_purchase_request_all" model="ir.actions.act_window">
        <field name="name">All Purchase Requests</field>
        <field name="res_model">purchase.request</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_purchase_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Purchase Request
            </p>
        </field>
    </record>

    <record id="action_purchase_request_my" model="ir.actions.act_window">
        <field name="name">My Purchase Requests</field>
        <field name="res_model">purchase.request</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('requester_id', '=', uid)]</field>
        <field name="context">{'default_requester_id': uid}</field>
    </record>

    <record id="action_purchase_request_waiting_my_approval" model="ir.actions.act_window">
        <field name="name">Waiting My Approval</field>
        <field name="res_model">purchase.request</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('state', '=', 'to_approve'), ('pending_approver_ids', 'in', [uid])]</field>
    </record>
</odoo>
